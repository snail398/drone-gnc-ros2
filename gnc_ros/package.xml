<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gnc_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes that connect gnc_core algorithms to PX4 via uXRCE-DDS.</description>
  <maintainer email="r.m.shtykov@gmail.com">Roman Shtykov</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>gnc_core</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
